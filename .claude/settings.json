{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npx astro *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git tag v*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin rc/v*)",
      "Bash(git push origin v*)",
      "Bash(git rev-parse *)",
      "Bash(git describe *)",
      "Bash(git rev-list *)",
      "Bash(curl -sI https://portfolio-v2-sigma-two.vercel.app/*)",
      "Bash(gh api repos/JanPodzimek/portfolio/deployments -X GET *)",
      "Bash(gh api repos/JanPodzimek/portfolio/deployments/*/statuses -q *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *-X=DELETE*)",
      "Bash(gh api *-X=delete*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *-Xdelete*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *--method=delete*)",
      "Bash(gh api *-X POST*)",
      "Bash(gh api *-X post*)",
      "Bash(gh api *-X=POST*)",
      "Bash(gh api *-X=post*)",
      "Bash(gh api *-XPOST*)",
      "Bash(gh api *-Xpost*)",
      "Bash(gh api *--method POST*)",
      "Bash(gh api *--method post*)",
      "Bash(gh api *--method=POST*)",
      "Bash(gh api *--method=post*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *-X patch*)",
      "Bash(gh api *-X=PATCH*)",
      "Bash(gh api *-X=patch*)",
      "Bash(gh api *-XPATCH*)",
      "Bash(gh api *-Xpatch*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method patch*)",
      "Bash(gh api *--method=PATCH*)",
      "Bash(gh api *--method=patch*)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *-X put*)",
      "Bash(gh api *-X=PUT*)",
      "Bash(gh api *-X=put*)",
      "Bash(gh api *-XPUT*)",
      "Bash(gh api *-Xput*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method put*)",
      "Bash(gh api *--method=PUT*)",
      "Bash(gh api *--method=put*)",
      "Bash(gh api *deployments/* -f *)",
      "Bash(gh api *deployments/* -F *)",
      "Bash(gh api *deployments/* --field*)",
      "Bash(gh api *deployments/* --raw-field*)",
      "Bash(gh api *deployments/* --input*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh auth refresh*)",
      "Bash(gh secret*)",
      "Bash(gh release delete*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
