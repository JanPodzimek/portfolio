{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npx astro *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git tag v*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin rc/v*)",
      "Bash(git push origin v*)",
      "Bash(git rev-parse *)",
      "Bash(git describe *)",
      "Bash(git rev-list *)",
      "Bash(curl -sI https://portfolio-v2-sigma-two.vercel.app/*)",
      "Bash(gh api 'repos/JanPodzimek/portfolio/deployments?environment=Production&sha=*' -q *)",
      "Bash(gh api repos/JanPodzimek/portfolio/deployments/*/statuses -q *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh api *-X D*)",
      "Bash(gh api *-X=D*)",
      "Bash(gh api *-XD*)",
      "Bash(gh api *--method D*)",
      "Bash(gh api *--method=D*)",
      "Bash(gh api *-X d*)",
      "Bash(gh api *-X=d*)",
      "Bash(gh api *-Xd*)",
      "Bash(gh api *--method d*)",
      "Bash(gh api *--method=d*)",
      "Bash(gh api *-X P*)",
      "Bash(gh api *-X=P*)",
      "Bash(gh api *-XP*)",
      "Bash(gh api *--method P*)",
      "Bash(gh api *--method=P*)",
      "Bash(gh api *-X p*)",
      "Bash(gh api *-X=p*)",
      "Bash(gh api *-Xp*)",
      "Bash(gh api *--method p*)",
      "Bash(gh api *--method=p*)",
      "Bash(gh api *deployments* -f*)",
      "Bash(gh api *deployments* -F*)",
      "Bash(gh api *deployments* --field*)",
      "Bash(gh api *deployments* --raw-field*)",
      "Bash(gh api *deployments* --input*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh auth refresh*)",
      "Bash(gh secret*)",
      "Bash(gh release delete*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
