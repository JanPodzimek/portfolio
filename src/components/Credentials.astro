---
import Section from './Section.astro';
import { t, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { credentials: c } = t(Astro.props.locale);
---

<Section id="credentials" index="07" title={c.title}>
  <div class="grid gap-8 md:grid-cols-2">
    <div>
      <h3 class="text-sm font-semibold tracking-wider text-muted uppercase">
        {c.certificationsTitle}
      </h3>
      <ul class="mt-4 space-y-4">
        {c.certifications.map((cert) => (
          <li class="card p-5">
            <p class="font-semibold">{cert.title}</p>
            <p class="mt-1 text-sm text-muted">
              {cert.issuer} · <span class="font-mono">{cert.date}</span>
            </p>
            <a
              class="link mt-3 inline-block text-sm"
              href={cert.href}
              target="_blank"
              rel="noopener"
            >
              {c.viewCertificate}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold tracking-wider text-muted uppercase">{c.educationTitle}</h3>
      <ul class="mt-4 space-y-4">
        {c.education.map((e) => (
          <li class="card p-5">
            <p class="font-semibold">{e.title}</p>
            <p class="mt-1 text-sm text-muted">
              {e.school} · <span class="font-mono">{e.period}</span>
            </p>
            <p class="mt-2 text-sm">{e.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
