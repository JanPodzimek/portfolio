---
import Section from './Section.astro';
import { t, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { credentials: c } = t(Astro.props.locale);
// From md up, both columns are subgrids of one grid: a heading row, then one equal (1fr) row
// per card, so every card is as tall as the tallest one, in both columns.
const cards = Math.max(c.certifications.length, c.education.length);
---

<Section id="credentials" index="07" title={c.title}>
  <div
    class="grid gap-8 md:grid-cols-2 md:grid-rows-[auto] md:auto-rows-fr md:gap-y-4"
    style={`--cards: ${cards}; --rows: ${cards + 1}`}
  >
    <div class="md:row-span-(--rows) md:grid md:grid-rows-subgrid">
      <h3 class="text-sm font-semibold tracking-wider text-muted uppercase">
        {c.certificationsTitle}
      </h3>
      <ul class="mt-4 space-y-4 md:row-span-(--cards) md:mt-0 md:grid md:grid-rows-subgrid md:space-y-0">
        {c.certifications.map((cert) => (
          <li class="card flex flex-col p-5">
            <p class="font-semibold">{cert.title}</p>
            <p class="mt-1 text-sm text-muted">
              {cert.issuer} · <span class="font-mono">{cert.date}</span>
            </p>
            <a
              class="link mt-auto self-start pt-3 text-sm"
              href={cert.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {c.viewCertificate}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="md:row-span-(--rows) md:grid md:grid-rows-subgrid">
      <h3 class="text-sm font-semibold tracking-wider text-muted uppercase">{c.educationTitle}</h3>
      <ul class="mt-4 space-y-4 md:row-span-(--cards) md:mt-0 md:grid md:grid-rows-subgrid md:space-y-0">
        {c.education.map((e) => (
          <li class="card p-5">
            <p class="font-semibold">{e.title}</p>
            <p class="mt-1 text-sm text-muted">
              {e.school} · <span class="font-mono">{e.period}</span>
            </p>
            <p class="mt-2 text-sm">{e.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
