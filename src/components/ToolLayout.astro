---
import Base from '@/layouts/Base.astro';
import { t, localePath, type Locale } from '@/i18n/utils';
import { tools, type ToolKey } from '@/data/tools';
import { repoFileUrl } from '@/data/site';

interface Props {
  locale: Locale;
  toolKey: ToolKey;
}
const { locale, toolKey } = Astro.props;
const dict = t(locale);
const text = dict.tools[toolKey];
const tool = tools.find((x) => x.key === toolKey)!;
---

<Base
  locale={locale}
  title={`${text.title} · ${dict.meta.toolsTitle}`}
  description={text.description}
>
  <div class="container-page py-10 sm:py-14">
    <a class="link text-sm" href={localePath(locale, '/tools/')}>
      ← {dict.tools.backToTools}
    </a>
    <p class="eyebrow mt-6">/tools/{tool.slug}</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{text.title}</h1>
    <p class="mt-3 max-w-2xl text-muted">{text.description}</p>
    <hr class="my-8 border-line" />
    <slot />
    <p class="mt-10 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs text-muted">
      <a class="link" href={repoFileUrl(tool.source)} target="_blank" rel="noopener noreferrer">
        {dict.tools.viewSource}: {tool.source}
      </a>
      {tool.tests.map((path) => (
        <a class="link" href={repoFileUrl(path)} target="_blank" rel="noopener noreferrer">
          {dict.tools.viewTests}: {path}
        </a>
      ))}
    </p>
  </div>
</Base>
