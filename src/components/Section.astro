---
interface Props {
  id: string;
  index: string;
  title: string;
  intro?: string;
}
const { id, index, title, intro } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="container-page reveal py-16 sm:py-20">
  <p class="eyebrow" aria-hidden="true">
    {index} / {id}
  </p>
  <h2 id={`${id}-title`} class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
    {title}
  </h2>
  {intro && <p class="mt-3 max-w-2xl text-muted">{intro}</p>}
  <div class="mt-8">
    <slot />
  </div>
</section>
